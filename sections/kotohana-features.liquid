<div class="kotohana-container">
  <h2 class="kotohana-section-title">
    {% if section.settings.heading != blank %}
      {{ section.settings.heading }}
    {% else %}
      {{ 'kotohana.features.title' | t }}
    {% endif %}
  </h2>
  <p class="kotohana-section-subtitle">
    {% if section.settings.subheading != blank %}
      {{ section.settings.subheading }}
    {% else %}
      {{ 'kotohana.features.subtitle' | t }}
    {% endif %}
  </p>
  <div class="kotohana-grid-3">
    {% for block in section.blocks %}
      <div class="kotohana-card" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.features",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "text", "id": "subheading", "label": "t:labels.subheading" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:general.feature_item",
      "settings": [
        { "type": "text", "id": "title", "label": "t:labels.title" },
        { "type": "textarea", "id": "text", "label": "t:labels.content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "国内工房の丁寧な仕上げ",
            "text": "架空の国内工房で一つひとつ丁寧に仕上げています。毎日の肌にやさしい使い心地を目指しました。"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "毎日続けられるやさしさ",
            "text": "香りや刺激に配慮した架空の処方で、朝晩の習慣に取り入れやすい使用感です。"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "環境に配慮した梱包",
            "text": "過剰な包装を省いた架空のエコ梱包でお届けします。段ボールはリサイクル素材を使っています。"
          }
        }
      ]
    }
  ]
}
{% endschema %}
