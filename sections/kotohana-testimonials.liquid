<div class="kotohana-container">
  <h2 class="kotohana-section-title">
    {% if section.settings.heading != blank %}
      {{ section.settings.heading }}
    {% else %}
      {{ 'kotohana.testimonials.title' | t }}
    {% endif %}
  </h2>
  <p class="kotohana-section-subtitle">
    {% if section.settings.subheading != blank %}
      {{ section.settings.subheading }}
    {% else %}
      {{ 'kotohana.testimonials.subtitle' | t }}
    {% endif %}
  </p>
  <div class="kotohana-grid-3">
    {% for block in section.blocks %}
      <div class="kotohana-card" {{ block.shopify_attributes }}>
        <p>{{ block.settings.quote }}</p>
        <p>{{ block.settings.name }}{% if block.settings.role != blank %} ({{ block.settings.role }}){% endif %}</p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "text", "id": "subheading", "label": "t:labels.subheading" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:general.testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "t:labels.quote" },
        { "type": "text", "id": "name", "label": "t:labels.name" },
        { "type": "text", "id": "role", "label": "t:labels.role" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "泡立ちがきめ細かく、洗い上がりがつっぱりません。香りも穏やかで続けやすいです。",
            "name": "30代・会社員",
            "role": "リピーター"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "定期便で買い忘れがなくなりました。梱包が簡素でゴミが少ないのも気に入っています。",
            "name": "40代・自営業",
            "role": "定期便利用中"
          }
        }
      ]
    }
  ]
}
{% endschema %}
