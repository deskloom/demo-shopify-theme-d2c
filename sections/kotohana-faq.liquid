<div class="kotohana-container">
  <h2 class="kotohana-section-title">
    {% if section.settings.heading != blank %}
      {{ section.settings.heading }}
    {% else %}
      {{ 'kotohana.faq.title' | t }}
    {% endif %}
  </h2>
  <p class="kotohana-section-subtitle">
    {% if section.settings.subheading != blank %}
      {{ section.settings.subheading }}
    {% else %}
      {{ 'kotohana.faq.subtitle' | t }}
    {% endif %}
  </p>
  <div>
    {% for block in section.blocks %}
      <details class="kotohana-faq-item" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div>{{ block.settings.answer }}</div>
      </details>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "text", "id": "subheading", "label": "t:labels.subheading" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "t:general.faq_item",
      "settings": [
        { "type": "text", "id": "question", "label": "t:labels.question" },
        { "type": "richtext", "id": "answer", "label": "t:labels.answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.faq",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "定期便に回数の縛りはありますか？",
            "answer": "<p>回数の縛りはありません。いつでも解約できます。</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "送料はいくらですか？",
            "answer": "<p>全国一律550円です。8,000円以上のご注文で送料無料になります。</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "返品はできますか？",
            "answer": "<p>未開封に限り、到着後14日以内であれば返品を受け付けます。</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
