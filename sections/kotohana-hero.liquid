<div class="kotohana-container">
  <div class="kotohana-hero">
    <div>
      <span class="kotohana-hero__badge">
        {% if section.settings.badge != blank %}
          {{ section.settings.badge }}
        {% else %}
          {{ 'kotohana.hero.badge' | t }}
        {% endif %}
      </span>
      <h1 class="kotohana-hero__title">
        {% if section.settings.heading != blank %}
          {{ section.settings.heading }}
        {% else %}
          {{ 'kotohana.hero.title' | t }}
        {% endif %}
      </h1>
      <p class="kotohana-hero__subtitle">
        {% if section.settings.subheading != blank %}
          {{ section.settings.subheading }}
        {% else %}
          {{ 'kotohana.hero.subtitle' | t }}
        {% endif %}
      </p>
      <p>
        <a class="kotohana-hero__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
          {% if section.settings.cta_label != blank %}
            {{ section.settings.cta_label }}
          {% else %}
            {{ 'kotohana.hero.cta' | t }}
          {% endif %}
        </a>
      </p>
    </div>
    <div class="kotohana-hero__media">
      {% if section.settings.image %}
        {{ section.settings.image | image_url: width: 1200 | image_tag }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    { "type": "text", "id": "badge", "label": "t:labels.badge" },
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "textarea", "id": "subheading", "label": "t:labels.subheading" },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "text", "id": "cta_label", "label": "t:labels.cta_label" },
    { "type": "url", "id": "cta_link", "label": "t:labels.cta_link" }
  ],
  "presets": [{ "name": "t:general.hero" }]
}
{% endschema %}
