<div class="kotohana-container">
  <h2 class="kotohana-section-title">
    {% if section.settings.heading != blank %}
      {{ section.settings.heading }}
    {% else %}
      {{ 'kotohana.featured_collection.title' | t }}
    {% endif %}
  </h2>
  <p class="kotohana-section-subtitle">
    {% if section.settings.subheading != blank %}
      {{ section.settings.subheading }}
    {% else %}
      {{ 'kotohana.featured_collection.subtitle' | t }}
    {% endif %}
  </p>
  {% assign target_collection = collections[section.settings.collection] %}
  {% if target_collection %}
    <div class="kotohana-products">
      {% for product in target_collection.products limit: section.settings.products_to_show %}
        <div class="kotohana-product-card">
          <a href="{{ product.url }}">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 600 | image_tag }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag }}
            {% endif %}
          </a>
          <div class="kotohana-product-card__body">
            <p><a href="{{ product.url }}">{{ product.title }}</a></p>
            {% if section.settings.show_vendor %}
              <p>{{ product.vendor }}</p>
            {% endif %}
            {% if section.settings.show_price %}
              <p>{{ product.price | money }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    <p><a href="{{ target_collection.url }}">{{ 'kotohana.featured_collection.view_all' | t }}</a></p>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:general.featured_collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "text", "id": "subheading", "label": "t:labels.subheading" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    { "type": "checkbox", "id": "show_price", "label": "t:labels.show_price", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "t:labels.show_vendor", "default": false }
  ],
  "presets": [{ "name": "t:general.featured_collection" }]
}
{% endschema %}
